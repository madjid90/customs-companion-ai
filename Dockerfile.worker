FROM node:22-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils python3 python3-venv ca-certificates tini \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /opt/douane-python \
  && /opt/douane-python/bin/pip install --no-cache-dir 'pypdfium2==5.1.0' 'Pillow==11.3.0'

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY scripts ./scripts

ENV NODE_ENV=production \
    PYTHON_PATH=/opt/douane-python/bin/python3 \
    PDFTOPPM_PATH=/usr/bin/pdftoppm \
    TESSERACT_CACHE_PATH=/var/cache/douane-ai/tesseract \
    OCR_LANGUAGES=fra+ara+eng \
    OCR_DPI=220 \
    WORKER_BATCH_SIZE=3 \
    HEALTH_PORT=8080

RUN mkdir -p /var/cache/douane-ai/tesseract && chown -R node:node /app /var/cache/douane-ai
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","scripts/run-ingestion-worker.mjs","--loop"]
