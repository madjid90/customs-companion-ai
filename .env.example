# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Récupérez ces valeurs depuis votre dashboard Supabase:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Worker serveur uniquement. Ne jamais préfixer cette clé par VITE_ et ne jamais
# l'installer dans le navigateur ou dans une application cliente.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server-secret-only"
CORPUS_WORKER_ID="ocr-worker-local-1"
WORKER_BATCH_SIZE="3"
OCR_LANGUAGES="fra+ara+eng"
OCR_DPI="220"
TESSERACT_CACHE_PATH="/tmp/douane-ai-tesseract-cache"
# PDFTOPPM_PATH="/absolute/path/to/pdftoppm"

# ===========================================
# INSTRUCTIONS
# ===========================================
# 1. Copiez ce fichier vers .env
#    cp .env.example .env
#
# 2. Remplacez les valeurs par vos vraies clés
#
# 3. NE COMMITEZ JAMAIS le fichier .env
# ===========================================
